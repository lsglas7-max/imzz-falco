# TANPA API KEY: kalau semua kolom di bawah dikosongkan, proxy otomatis memakai 2 API kyio bawaan
# (gpt-5, lalu gpt-6-luna kalau gagal). Itu model teks: screenshot diabaikan, yang dipakai teks OCR + objek mencolok dari app.
# KYIO_URLS=https://api.kyio.web.id/api/v2/ai/gpt-5?q=,https://api.kyio.web.id/api/v2/ai/gpt-6-luna?q=

# Salin ke .env (Termux) atau isi di Vercel > Settings > Environment Variables.
# OPSIONAL — hanya kalau suatu saat punya key model yang BISA melihat gambar (otomatis dipakai lebih dulu):

# --- Opsi A: Google Gemini (ada tier gratis, bisa melihat gambar) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Opsi B: API kompatibel OpenAI (OpenAI, OpenRouter, dll) yang mendukung gambar ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# Kunci pengaman: kalau diisi, URL di app harus ditambah ?token=ISI_INI
PROXY_TOKEN=
